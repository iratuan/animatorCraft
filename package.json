{
  "name": "stickboard",
  "productName": "StickBoard",
  "version": "0.4.0",
  "description": "Gerador de vídeos whiteboard com personagens animados, para ensino de ciências, matemática e inglês",
  "author": "StickBoard",
  "private": true,
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "cross-env SEM_ELECTRON=1 vite",
    "build": "vite build",
    "start": "electron .",
    "test": "vitest run",
    "e2e": "node tools/testar-novos-recursos.mjs && node tools/testar-timeline-arrasto.mjs && node tools/testar-posicao-palco.mjs && node tools/testar-audio.mjs && node tools/testar-graficos.mjs && node tools/testar-ia.mjs && node tools/testar-projeto.mjs && node tools/testar-lousa-sem-mao.mjs && node tools/testar-imagens.mjs && node tools/testar-editor-imagem.mjs && node tools/testar-editor-imagem-2.mjs && node tools/testar-editor-imagem-3.mjs && node tools/testar-exportar-sprites.mjs && node tools/testar-editar-sprite.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "android:sync": "cross-env SEM_ELECTRON=1 vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "fflate": "^0.8.2",
    "mp4-muxer": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@electron/packager": "^18.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.stickboard.app",
    "productName": "StickBoard",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "electronDist": "node_modules/electron/dist",
    "win": { "signAndEditExecutable": false, "icon": "assets/icon.png", "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "StickBoard-${version}-portatil.exe" }
  }
}

